<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Obd2Dash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSecondary">@color/amber</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>

        <item name="gaugeAccent">@color/accent</item>
        <item name="gaugeWarn">@color/danger</item>
        <item name="gaugeTrack">@color/track</item>
    </style>

    <style name="TileValue">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="TileLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
</resources>
