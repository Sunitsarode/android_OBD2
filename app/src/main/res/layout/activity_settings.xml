<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView style="@style/SettingSection" android:text="Android Auto (car screen)" />

        <TextView
            android:id="@+id/autoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/autoSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/openAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Open Android Auto settings" />

        <TextView style="@style/SettingSection" android:text="Vehicle and fuel" />

        <TextView style="@style/SettingLabel" android:text="Fuel system" />
        <Spinner android:id="@+id/fuelSystem" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/biFuelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SettingLabel" android:text="Detect which fuel is in use" />
            <Spinner android:id="@+id/fuelDetection" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/ecuFuelReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView style="@style/SettingLabel" android:text="Engine displacement (litres)" />
        <EditText android:id="@+id/displacement" style="@style/SettingInput" android:inputType="numberDecimal" />

        <TextView android:id="@+id/tankLabel" style="@style/SettingLabel" android:text="Petrol tank capacity (litres)" />
        <EditText android:id="@+id/tankSize" style="@style/SettingInput" android:inputType="numberDecimal" />

        <TextView android:id="@+id/priceLabel" style="@style/SettingLabel" android:text="Petrol price per litre (0 = off)" />
        <EditText android:id="@+id/fuelPrice" style="@style/SettingInput" android:inputType="numberDecimal" />

        <LinearLayout
            android:id="@+id/cngGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SettingSection" android:text="CNG" />

            <TextView style="@style/SettingLabel" android:text="CNG price per kg (0 = off)" />
            <EditText android:id="@+id/cngPrice" style="@style/SettingInput" android:inputType="numberDecimal" />

            <TextView style="@style/SettingLabel" android:text="CNG cylinder capacity (kg)" />
            <EditText android:id="@+id/cngCapacity" style="@style/SettingInput" android:inputType="numberDecimal" />

            <TextView style="@style/SettingLabel" android:text="Low CNG alert below (kg, 0 = off)" />
            <EditText android:id="@+id/lowCng" style="@style/SettingInput" android:inputType="numberDecimal" />

            <TextView style="@style/SettingLabel" android:text="Cylinder hydro-test due (DD-MM-YYYY, blank = off)" />
            <EditText android:id="@+id/cylinderTest" style="@style/SettingInput" android:hint="e.g. 15-03-2028" android:inputType="text" />

            <TextView
                android:id="@+id/cngNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="OBD has no CNG gauge, so CNG left is counted down from your last fill-up. Log fill-ups on the Trip tab. The cylinder test is due every 3 years; the date is on the cylinder or its test certificate."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lpgGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SettingLabel" android:text="LPG price per litre (0 = off)" />
            <EditText android:id="@+id/lpgPrice" style="@style/SettingInput" android:inputType="numberDecimal" />
        </LinearLayout>

        <TextView style="@style/SettingLabel" android:text="Tachometer redline (rpm)" />
        <EditText android:id="@+id/redline" style="@style/SettingInput" android:inputType="number" />

        <TextView style="@style/SettingSection" android:text="Gearbox" />

        <TextView style="@style/SettingLabel" android:text="Transmission" />
        <Spinner android:id="@+id/transmission" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/SettingLabel" android:text="Number of forward gears" />
        <Spinner android:id="@+id/gearCount" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/SettingLabel" android:text="Shift-up hint above (rpm, 0 = off, manual only)" />
        <EditText android:id="@+id/shiftUpRpm" style="@style/SettingInput" android:inputType="number" />

        <TextView
            android:id="@+id/learnedGears"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/resetGears"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Relearn gears" />

        <TextView style="@style/SettingSection" android:text="Alerts" />

        <TextView style="@style/SettingLabel" android:text="Speed limit alert (km/h, 0 = off)" />
        <EditText android:id="@+id/speedLimit" style="@style/SettingInput" android:inputType="number" />

        <TextView style="@style/SettingLabel" android:text="Overheat alert (coolant, C)" />
        <EditText android:id="@+id/overheat" style="@style/SettingInput" android:inputType="number" />

        <TextView style="@style/SettingLabel" android:text="Low fuel alert (%, 0 = off)" />
        <EditText android:id="@+id/lowFuel" style="@style/SettingInput" android:inputType="number" />

        <CheckBox android:id="@+id/alertBeep" style="@style/SettingCheck" android:text="Beep on alerts" />
        <CheckBox android:id="@+id/alertVoice" style="@style/SettingCheck" android:text="Speak alerts (text-to-speech)" />

        <TextView style="@style/SettingSection" android:text="Display and connection" />

        <TextView style="@style/SettingLabel" android:text="Show fuel economy as" />
        <Spinner android:id="@+id/economyUnit" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <CheckBox android:id="@+id/imperial" style="@style/SettingCheck" android:text="Imperial units (mph, F, psi, mpg)" />
        <CheckBox android:id="@+id/keepScreenOn" style="@style/SettingCheck" android:text="Keep screen on while connected" />
        <CheckBox android:id="@+id/autoConnect" style="@style/SettingCheck" android:text="Reconnect to last adapter on launch" />
        <CheckBox android:id="@+id/startOnBoot" style="@style/SettingCheck" android:text="Start when the head unit boots" />
        <CheckBox android:id="@+id/fastPolling" style="@style/SettingCheck" android:text="Fast polling (turn off if readings freeze or go blank)" />
        <CheckBox android:id="@+id/logging" style="@style/SettingCheck" android:text="Log every sample to CSV" />

        <TextView
            android:id="@+id/logPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/reconnectNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fast polling and logging changes apply on the next connection."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Save" />
    </LinearLayout>
</ScrollView>
